# Wird von deploy.sh nach /srv/caddy/sites/ kopiert. Die Web-App spricht direkt
# aus dem Browser mit IBS5; connect-src erlaubt genau das und sonst nichts.
sunshine.thomschke.info {
	root * /srv/sunshine/web
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://ibs.sunshine-catering.de; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Hülle immer frisch prüfen lassen, sonst hängt ein Deploy am Browser-Cache.
	@shell path / /index.html /sw.js /app.js /ibs.js /style.css /manifest.webmanifest
	header @shell Cache-Control "no-cache"

	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json

	file_server
}
