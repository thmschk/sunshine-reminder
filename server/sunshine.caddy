# Wird von deploy.sh nach /srv/caddy/sites/ kopiert. Die Web-App spricht direkt
# aus dem Browser mit IBS5; connect-src erlaubt genau das und sonst nichts.
sunshine.thomschke.info {
	root * /srv/sunshine/web
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://ibs.sunshine-catering.de; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'; worker-src 'self'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Hülle und Icons immer frisch prüfen lassen, sonst hängt ein Deploy am
	# Browser-Cache (neue Icons zusätzlich mit ?v= im Manifest, sonst bleibt das
	# alte beim Installieren hängen).
	@shell path / *.html *.js *.css *.webmanifest *.png *.svg
	header @shell Cache-Control "no-cache"

	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json

	handle /api/* {
		reverse_proxy 127.0.0.1:18080
	}

	file_server
}
