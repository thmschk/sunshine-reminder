# Wird von deploy.sh nach /srv/caddy/sites/ kopiert. Die Web-App spricht direkt
# aus dem Browser mit IBS5; connect-src erlaubt genau das und sonst nichts.
# Hauptadresse ist sunshine-order.de. sunshine.thomschke.info bleibt gleichwertig in Betrieb
# statt umzuleiten: Anmeldung, Push-Abo und installierte App hängen an der Adresse,
# eine Weiterleitung würde bisherige Nutzer abmelden.
www.sunshine-order.de {
	redir https://sunshine-order.de{uri} permanent
}

sunshine-order.de, sunshine.thomschke.info {
	root * /srv/sunshine/web
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://ibs.sunshine-catering.de; img-src 'self' data: https://ibs.sunshine-catering.de; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'; worker-src 'self'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Hülle, ferien.json, version.txt und Bilder ohne ?v= immer frisch prüfen lassen, sonst hängt
	# ein Deploy am Browser-Cache. Neue Icons bekommen ein neues ?v= (Manifest, sw.js, index.html),
	# sonst bleibt das alte beim Installieren hängen.
	@shell {
		path / *.html *.js *.css *.json *.txt *.webmanifest *.png *.svg
		not {
			path *.png *.svg
			query v=*
		}
	}
	header @shell Cache-Control "no-cache"

	# Bilder mit ?v= ändern sich nie (neue Fassung = neues v); Push-Meldungen laden Icon und
	# Badge sonst bei jedem Anzeigen neu.
	@versioned {
		path *.png *.svg
		query v=*
	}
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json

	# max_size passend zu MAX_BODY in server/push/app.py (4096), mit Luft. request_buffers liest
	# den Body erst ganz ein, bevor er zum Push-Dienst geht: langsame Clients binden dann nur
	# Caddy, nicht dessen Threads (dort zusätzlich REQUEST_DEADLINE je Anfrage).
	handle /api/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:18080 {
			request_buffers 16KB
		}
	}

	# Kurze Adresse der Statistikseite.
	rewrite /stats /stats.html

	file_server
}
